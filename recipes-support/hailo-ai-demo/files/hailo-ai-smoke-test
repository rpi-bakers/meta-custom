#!/bin/sh

set -eu

MODEL_PATH="${1:-/usr/share/hailo-models/yolov8s_h8l.hef}"

echo "[hailo-ai-smoke-test] Start"

if ! command -v hailortcli >/dev/null 2>&1; then
    echo "hailortcli was not found."
    echo "Install Hailo runtime packages with HAILO_RUNTIME_PACKAGES in local.conf."
    exit 1
fi

echo "[1/3] Identify Hailo device"
hailortcli fw-control identify

echo "[1.5/3] Validate Hailo GStreamer plugins (optional)"
if command -v gst-inspect-1.0 >/dev/null 2>&1; then
    if gst-inspect-1.0 | grep -q "hailo"; then
        echo "Detected Hailo GStreamer elements"
        gst-inspect-1.0 | grep "hailo" || true
    else
        echo "No Hailo GStreamer elements were found."
        echo "Install libgsthailo / libgsthailotools / hailo-post-processes if needed."
    fi

    if [ -d /usr/lib/hailo-post-processes ]; then
        echo "Found /usr/lib/hailo-post-processes"
    fi
fi

echo "[2/3] Benchmark"
if [ -f "${MODEL_PATH}" ]; then
    hailortcli benchmark "${MODEL_PATH}"
else
    echo "Model file was not found: ${MODEL_PATH}"
    echo "Install model package and rerun with:"
    echo "  hailo-ai-smoke-test /path/to/model.hef"
fi

echo "[3/3] rpicam command examples"
echo "If connected over SSH, export display first:"
echo "  export DISPLAY=:0.0"
echo ""
echo "Object Detection (YOLOv6):"
echo "  rpicam-hello -t 0 --post-process-file /usr/share/rpicam-apps/assets/hailo_yolov6_inference.json --lores-width 640 --lores-height 640"
echo "Object Detection (YOLOv8):"
echo "  rpicam-hello -t 0 --post-process-file /usr/share/rpicam-apps/assets/hailo_yolov8_inference.json --lores-width 640 --lores-height 640"
echo "Object Detection (YoloX):"
echo "  rpicam-hello -t 0 --post-process-file /usr/share/rpicam-apps/assets/hailo_yolox_inference.json --lores-width 640 --lores-height 640"
echo "Person + Face (YOLOv5):"
echo "  rpicam-hello -t 0 --post-process-file /usr/share/rpicam-apps/assets/hailo_yolov5_personface.json --lores-width 640 --lores-height 640"
echo "Segmentation:"
echo "  rpicam-hello -t 0 --post-process-file /usr/share/rpicam-apps/assets/hailo_yolov5_segmentation.json --lores-width 640 --lores-height 640 --framerate 20"
echo "Pose Estimation:"
echo "  rpicam-hello -t 0 --post-process-file /usr/share/rpicam-apps/assets/hailo_yolov8_pose.json --lores-width 640 --lores-height 640"

echo "[hailo-ai-smoke-test] Done"
