From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Local Builder <builder@local>
Date: Mon, 15 Jun 2026 00:00:00 +0000
Subject: [PATCH] preview: allow Qt6 for qt-preview backend

The current meson file requests only qt5, but this distro ships Qt6.
Try Qt6 first and fall back to Qt5 for compatibility.

Upstream-Status: Inappropriate [Yocto integration for Qt6-based distro]

---
 preview/meson.build | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/preview/meson.build b/preview/meson.build
index cf6f166..59f8f55 100644
--- a/preview/meson.build
+++ b/preview/meson.build
@@ -45,7 +45,10 @@ if x11_deps.found() and epoxy_deps.found()
 endif
 
 enable_qt = false
-qt_dep = dependency('qt5', modules : ['Core', 'Widgets'], required : get_option('enable_qt'))
+qt_dep = dependency('qt6', modules : ['Core', 'Widgets'], required : false)
+if not qt_dep.found()
+    qt_dep = dependency('qt5', modules : ['Core', 'Widgets'], required : get_option('enable_qt'))
+endif
 if qt_dep.found()
     egl_lib = shared_module('qt-preview', files('qt_preview.cpp'),
                             include_directories : '../',
-- 
