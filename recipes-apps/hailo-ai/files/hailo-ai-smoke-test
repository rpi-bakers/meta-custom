#!/bin/sh

set -eu

MODEL_PATH="${1:-/usr/share/hailo-models/yolov8s_h8l.hef}"

echo "[hailo-ai-smoke-test] Start"

if ! command -v hailortcli >/dev/null 2>&1; then
    echo "[error] hailortcli was not found."
    echo "[info] Install Hailo runtime packages with HAILO_RUNTIME_PACKAGES in local.conf."
    exit 1
fi

echo ""
echo "[1/3] Identify Hailo device"

echo "------------------------------"
echo "[cmd] hailortcli fw-control identify"
hailortcli fw-control identify


echo "------------------------------"
echo "[cmd] lspci | grep -i hailo"
lspci | grep -i hailo

echo "---------------------------------------------------"
echo "[1.5/3] Validate Hailo GStreamer plugins (optional)"
if command -v gst-inspect-1.0 >/dev/null 2>&1; then
    if gst-inspect-1.0 | grep -q "hailo"; then
        echo "[info] Detected Hailo GStreamer elements"
        gst-inspect-1.0 | grep "hailo" || true
    else
        echo "[error] No Hailo GStreamer elements were found."
        echo "[info] Install libgsthailo / libgsthailotools / hailo-post-processes if needed."
    fi

        echo "-----------------------------------"
    if [ -d /usr/lib/hailo-post-processes ]; then
        echo "[info] Found /usr/lib/hailo-post-processes"
    fi
fi

echo "------------------------------"
echo "[2/3] Benchmark"

if [ -f "${MODEL_PATH}" ]; then
    hailortcli benchmark "${MODEL_PATH}"
else
    echo "---------------------------------------"
    echo "[error] Model file was not found: ${MODEL_PATH}"
    echo "Install model package and rerun with:"
    echo "  hailo-ai-smoke-test /path/to/model.hef"
fi

echo "[hailo-ai-smoke-test] Done"
